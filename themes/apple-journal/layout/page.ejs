<div class="page-workbench content-width">
  <%- partial('_partial/sidebar', { posts: site.posts.sort('date', -1).toArray() }) %>
  <article class="reading-shell content-panel page-shell">
  <header class="reading-header">
    <p class="section-kicker">页面</p>
    <h1><%= page.title %></h1>
    <% if (page.description) { %><p class="reading-lede"><%= page.description %></p><% } %>
  </header>
  <div class="article-body prose"><%- page.content %></div>
</article>
</div>
