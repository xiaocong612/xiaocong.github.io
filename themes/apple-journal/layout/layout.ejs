<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="generator" content="Hexo">
  <title><%= page.title ? `${page.title}｜${config.title}` : config.title %></title>
  <% if (page.description || config.description) { %>
    <meta name="description" content="<%= page.description || config.description %>">
  <% } %>
  <meta name="theme-color" content="#f5f5f7">
  <link rel="stylesheet" href="<%= url_for(theme.css) %>">
</head>
<% const isHome = page.layout === 'index' || page.layout === 'home' || page.path === 'index.html' || page.path === ''; %>
<body class="<%= isHome ? 'is-home' : '' %>" data-base-url="<%= url_for('/') %>">
  <a class="skip-link" href="#main-content">跳到主要内容</a>
  <%- partial('_partial/site-ui', { isHome }) %>
  <%- partial('_partial/header') %>
  <main id="main-content" class="site-main">
    <%- body %>
  </main>
  <%- partial('_partial/footer') %>
  <script src="<%= url_for('/vendor/highlight.min.js') %>" defer></script>
  <script src="<%= url_for('/js/code-blocks.js') %>" defer></script>
  <script src="<%= url_for('/js/site-ui.js') %>" defer></script>
  <% if (isHome) { %><script src="<%= url_for('/js/home-hero.js') %>" defer></script><% } %>
  <script src="<%= url_for(theme.js) %>" defer></script>
</body>
</html>
