<%
  const settings = site.data && site.data.settings ? site.data.settings : {};
%>
<footer class="site-footer">
  <div class="content-width footer-inner">
    <p><%= settings.footer_note || '保持好奇，持续记录。' %></p>
    <div class="footer-links">
      <% if (settings.social && settings.social.github) { %><a href="<%= settings.social.github %>" rel="me noopener" target="_blank">GitHub <span aria-hidden="true">↗</span></a><% } %>
      <span>© <%= new Date().getFullYear() %> <%= config.author %></span>
    </div>
  </div>
</footer>
