<canvas class="network-background" data-network-background aria-hidden="true"></canvas>

<button class="back-to-top" type="button" data-back-to-top aria-label="返回页面顶部">
  <span class="back-to-top-arrow back-to-top-arrow--primary" aria-hidden="true">↑</span>
  <span class="back-to-top-arrow back-to-top-arrow--alternate" aria-hidden="true">↑</span>
</button>

<% if (isHome) { %>
  <section class="liquid-panel" data-liquid-panel hidden aria-labelledby="liquid-panel-title">
    <div class="liquid-panel-header">
      <div>
        <p class="section-kicker">实验工具</p>
        <h2 id="liquid-panel-title">液态玻璃参数</h2>
      </div>
      <button class="liquid-panel-close" type="button" data-liquid-close aria-label="关闭液态玻璃参数">×</button>
    </div>
    <p class="liquid-panel-status" data-liquid-status>CSS 毛玻璃降级模式</p>
    <div class="liquid-panel-controls">
      <label>渲染引擎<select data-liquid-param="engine"><option value="css">CSS</option><option value="webgl">WebGL</option><option value="webgpu">WebGPU</option></select></label>
      <label>语言<select data-liquid-param="language"><option value="zh-CN">简体中文</option><option value="en">English</option></select></label>
      <label>色相<input type="range" min="0" max="360" step="1" value="210" data-liquid-param="hue"><output data-liquid-output="hue">210</output></label>
      <label>色调<select data-liquid-param="tone"><option value="light">明亮</option><option value="neutral">中性</option><option value="dark">深色</option></select></label>
      <label>折射厚度<input type="range" min="0" max="40" step="0.5" value="20" data-liquid-param="thickness"><output data-liquid-output="thickness">20</output></label>
      <label>背景距离<input type="range" min="0" max="1" step="0.01" value="0.05" data-liquid-param="backgroundDistance"><output data-liquid-output="backgroundDistance">0.05</output></label>
      <label>折射系数<input type="range" min="0" max="3" step="0.01" value="1.4" data-liquid-param="refraction"><output data-liquid-output="refraction">1.40</output></label>
      <label>色散<input type="range" min="0" max="20" step="0.1" value="7" data-liquid-param="dispersion"><output data-liquid-output="dispersion">7.0</output></label>
      <label>高光强度<input type="range" min="0" max="100" step="1" value="70" data-liquid-param="highlight"><output data-liquid-output="highlight">70</output></label>
      <label>模糊半径<input type="range" min="0" max="30" step="1" value="12" data-liquid-param="blur"><output data-liquid-output="blur">12</output></label>
      <label>阴影强度<input type="range" min="0" max="60" step="1" value="18" data-liquid-param="shadow"><output data-liquid-output="shadow">18</output></label>
    </div>
    <p class="liquid-panel-hint">首页按 Shift + T 显示或隐藏，Esc 关闭。参数只保存在当前会话。</p>
  </section>
<% } %>
