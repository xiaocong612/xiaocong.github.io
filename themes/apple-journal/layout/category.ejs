<%
  const categoryPosts = page.posts.sort('date', -1).toArray();
%>
<div class="page-workbench content-width">
  <%- partial('_partial/sidebar', { posts: site.posts.sort('date', -1).toArray() }) %>
  <div class="listing-shell content-panel">
    <header class="listing-header"><p class="section-kicker">分类</p><h1><%= page.category %></h1><p>这个分类下的全部记录。</p></header>
    <div class="post-stream"><% categoryPosts.forEach(post => { %><%- partial('_partial/article', { post, excerpt: true }) %><% }); %></div>
  </div>
</div>
